# docker-compose.yaml 的环境变量模板：cp .env.example .env 后替换全部占位值。
# .env 已被根 .gitignore 拦截，永不提交；所有密码仅限字母数字与常见符号
# （不得包含单引号、双引号、$、反引号，见 script/mysql/init/01-create-accounts.sh）。

# MySQL root 密码（仅容器初始化与运维处置使用，不注入应用）
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
# 运行时应用账号（仅业务 DML 权限，见 docs/adr/0009-separate-flyway-database-principal.md）
DB_USERNAME=framework_app
DB_PASSWORD=replace-with-strong-app-password
# Flyway 迁移账号（DDL + Flyway 元数据读取；prod 启动期拒绝与应用账号相同）
FLYWAY_USERNAME=framework_migrator
FLYWAY_PASSWORD=replace-with-strong-flyway-password
# Redis 访问密码
REDIS_PASSWORD=replace-with-strong-redis-password
# 32 字节随机密钥的 Base64（生成命令：openssl rand -base64 32）
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 管理端对外域名；prod fail-closed 校验拒绝 localhost、127.0.0.1、通配符与示例域名
CORS_ALLOWED_ORIGIN=https://admin.framework.internal
# WebAuthn RP ID 必须与 CORS 域名一致或为其父域，且不得包含 example/localhost
MFA_WEBAUTHN_RP_ID=framework.internal
MFA_WEBAUTHN_ALLOWED_ORIGIN=https://admin.framework.internal
# HTTP 短信回调默认关闭；启用时使用 `openssl rand -hex 32` 生成独立令牌。
SMS_CALLBACK_ENABLED=false
SMS_CALLBACK_TOKEN=replace-with-random-64-hex-character-token
FILE_PRESIGNED_UPLOAD_TTL=15m
FILE_PRESIGNED_UPLOAD_MAX_SIZE=16MB
